rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: check auth ────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.user_role == 'admin';
    }

    function isIct() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.user_role == 'ict';
    }

    function isHospitalAdministrator() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.user_role == 'hospital_administrator';
    }

    function isIctOrHigher() {
      return isAuthenticated()
        && (isAdmin() || isIct() || isHospitalAdministrator());
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // ── Users collection ──────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(userId) || isAdmin();
    }

    // ── App Settings (singleton) ──────────────────────
    match /appSettings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isIctOrHigher();
    }

    // ── Tickets ───────────────────────────────────────
    match /tickets/{ticketId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(get(/databases/$(database)/documents/tickets/$(ticketId)).data.createdBy)
                              || isIctOrHigher();
    }

    // ── Knowledge Base Articles ───────────────────────
    match /kbArticles/{articleId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isIctOrHigher();
    }

    // ── Notifications ─────────────────────────────────
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated()
        && (isOwner(get(/databases/$(database)/documents/notifications/$(notificationId)).data.targetUserId)
            || isAdmin());
    }

    // ── User Types ────────────────────────────────────
    match /user_types/{typeId} {
      allow read: if isAuthenticated();
      allow write: if isIctOrHigher();
    }

    // ── Deny everything else ──────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
