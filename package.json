{
    "name":  "medical-records-system",
    "version":  "1.0.8",
    "description":  "Medical Records System Web Application",
    "author":  {
                   "name":  "Matarr Sama",
                   "email":  "matarrsama@gmail.com"
               },
    "main":  "dist-electron/main.js",
    "type":  "module",
    "scripts":  {
                    "dev":  "vite",
                    "dev:electron":  "vite --mode electron",
                    "build":  "vite build",
                    "build:electron":  "vite build --mode electron",
                    "preview":  "vite preview",
                    "electron:dev":  "vite --mode electron",
                    "electron:build":  "vite build --mode electron \u0026\u0026 electron-builder",
                    "electron:preview":  "vite preview"
                },
    "devDependencies":  {
                            "@vitejs/plugin-vue":  "^6.0.7",
                            "autoprefixer":  "^10.5.0",
                            "electron":  "^42.3.0",
                            "electron-builder":  "^26.8.1",
                            "postcss":  "^8.5.15",
                            "tailwindcss":  "^3.4.19",
                            "vite":  "^5.2.11",
                            "vite-plugin-electron":  "^1.0.0",
                            "vite-plugin-electron-renderer":  "^1.0.0"
                        },
    "build":  {
                  "appId":  "com.hospital.itsm",
                  "productName":  "Medical Records System",
                  "directories":  {
                                      "output":  "release"
                                  },
                  "files":  [
                                "dist/**/*",
                                "dist-electron/**/*",
                                "package.json"
                            ],
                  "publish":  {
                                  "provider":  "github",
                                  "owner":  "matarrsama",
                                  "repo":  "Medical-System",
                                  "releaseType":  "release"
                              },
                  "win":  {
                              "target":  [
                                             {
                                                 "target":  "portable",
                                                 "arch":  [
                                                              "x64"
                                                          ]
                                             },
                                             {
                                                 "target":  "nsis",
                                                 "arch":  [
                                                              "x64"
                                                          ]
                                             }
                                         ],
                              "icon":  "public/icon.ico",
                              "artifactName":  "${productName}.Setup.${version}.${ext}"
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "allowToChangeInstallationDirectory":  true
                           },
                  "mac":  {
                              "target":  "dmg",
                              "icon":  "public/icon.png"
                          },
                  "linux":  {
                                "target":  "AppImage",
                                "icon":  "public/icon.png"
                            }
              },
    "dependencies":  {
                         "electron-updater":  "^6.8.9",
                         "firebase":  "^12.14.0",
                         "firebase-admin":  "^13.10.0",
                         "html2pdf.js":  "^0.14.0",
                         "pinia":  "^2.3.1",
                         "vue":  "^3.5.35",
                         "vue-router":  "^4.6.4"
                     }
}
