# ── Firebase Client (Vite) ──────────────────────────
# These are exposed to the browser via import.meta.env.VITE_*
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Set to 'true' to use local Firebase emulators (for development only)
VITE_USE_FIREBASE_EMULATORS=

# ── Firebase Admin (Netlify Functions) ──────────────
# These are used server-side by Netlify Functions via process.env
# Copy these from your Firebase service account JSON
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_PRIVATE_KEY_ID=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_CLIENT_ID=
FIREBASE_ADMIN_CLIENT_CERT_URL=
